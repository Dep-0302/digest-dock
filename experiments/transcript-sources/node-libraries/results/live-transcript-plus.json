      "requestStrategy": "Watch page for API key, ANDROID player request, then XML timedtext; optional retry/cache hooks are disabled in this benchmark.",
      "browserFit": "Node >=20 package; no browser export or ready-to-load MV3 bundle is declared."
    },
    "youtubei.js": {
      "package": "youtubei.js",
      "source": "https://github.com/LuanRT/YouTube.js",
      "adapter": "Innertube.create() -> getInfo(videoId) -> getTranscript()",
      "languageBehavior": "Transcript language selection uses human-readable menu labels rather than BCP-47 codes.",
      "requestStrategy": "Creates an Innertube session, requests video info/next data, then calls get_transcript.",

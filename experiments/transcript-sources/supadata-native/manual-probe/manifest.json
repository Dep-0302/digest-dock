{
  "manifest_version": 3,
  "name": "DigestDock Supadata Native Probe",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "description": "Experiment-only direct Supadata native-transcript control with per-attempt consent.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://api.supadata.ai/*",
    "https://www.youtube.com/*"
  ],
  "action": {
    "default_title": "Supadata native probe",
    "default_popup": "popup.html"
  }
}
